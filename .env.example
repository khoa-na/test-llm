# ───────────────────────────────────────────────
# Modal config (override khi deploy)
# ───────────────────────────────────────────────
# Set qua: modal deploy --env-var KEY=VALUE  hoặc edit modal_app.py defaults
MODEL_NAME=Qwen/Qwen3.5-9B-Instruct
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.92
DTYPE=auto
MODAL_GPU=A10G

# ───────────────────────────────────────────────
# Client config (chạy local trên máy để gọi endpoint)
# ───────────────────────────────────────────────
# URL hiển thị sau khi 'modal deploy modal_app.py'
MODAL_ENDPOINT_URL=

# Optional: HF token nếu model gated (Gemma, ...)
HUGGING_FACE_HUB_TOKEN=

# ───────────────────────────────────────────────
# LLM-as-Judge (Gemini)
# ───────────────────────────────────────────────
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
JUDGE_MODEL=gemini-2.5-flash
JUDGE_TEMPERATURE=0.0
EVAL_MAX_TOKENS=512
# Giới hạn request/phút cho judge API (free-tier Gemini = 15). Set 0 để tắt rate limit.
JUDGE_RPM=15
