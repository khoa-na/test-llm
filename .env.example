# ───────────────────────────────────────────────
# Worker config (chạy trong container trên RunPod)
# Set trong "Environment Variables" của Endpoint khi deploy.
# ───────────────────────────────────────────────
MODEL_NAME=Qwen/Qwen3.5-9B-Instruct
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.92
DTYPE=auto
TRUST_REMOTE_CODE=true

# Optional: HF token nếu model private hoặc gated (Gemma)
HUGGING_FACE_HUB_TOKEN=

# ───────────────────────────────────────────────
# Client config (chạy local trên máy, để gọi endpoint)
# ───────────────────────────────────────────────
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
